<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
      <NoWarn>$(NoWarn);EF1001;MSB3277;xUnit1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Using xunit.core and .assert instead of the main package because compilation fails due to warnings triggered by xunit.analyzers. -->
    <!-- <PackageReference Include="xunit" /> -->
    <PackageReference Include="xunit.core" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.runner.console" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Xunit.SkippableFact" />

    <!-- Override vulnerable transitive versions (9.0.0) pulled in by Microsoft.Build.Tasks.Core via EF Core Design/Specification.Tests. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Part of the ASP.NET Core shared framework, so Web SDK projects get it from there (NU1510 otherwise). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
  </ItemGroup>
</Project>
